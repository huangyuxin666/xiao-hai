usecase "加入购物车" as UC4
usecase "提交订单" as UC5
usecase "收藏商品" as UC6
usecase "私信卖家" as UC7
usecase "修改个人信息" as UC8
usecase "查看公告" as UC9

Student --> UC1
Student --> UC2
Student --> UC3
Student --> UC4
Student --> UC5
Student --> UC6
Student --> UC7
Student --> UC8
Student --> UC9
